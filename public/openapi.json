            "description": "Invalid URL."
          },
          "502": {
            "description": "Upstream failure; not charged."
          }
        },
        "x-payment-info": {
          "protocol": "x402",
          "price": "0.02",
          "network": "eip155:8453",
          "asset": "USDC"
        }
      }
    },
