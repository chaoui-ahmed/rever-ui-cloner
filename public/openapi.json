    "/page-markdown": {
      "post": {
        "operationId": "getPageMarkdown",
        "summary": "Convert a page to Markdown",
        "description": "Convert any web page into clean Markdown for LLMs: main content only (no nav, footer, scripts, cookie banners), with headings, lists, links, images, tables and code blocks preserved. Optional maxChars (1,000-200,000, default 50,000). Fast (1-3 s). Price: $0.01 per call via x402 (USDC on Base).",
        "security": [
          {
            "x402": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "maxChars": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 200000
                  }
                }
              }
            }
          }
        },
        "responses": {
