                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "logo": {
                      "type": "string"
                    },
                    "logoSvg": {
                      "type": "string"
                    },
                    "favicon": {
                      "type": "string"
                    },
                    "colors": {
                      "type": "array"
                    },
                    "fonts": {
                      "type": "array"
                    },
                    "cssVariables": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402)."
          },
          "400": {
            "description": "Invalid URL."
          },
