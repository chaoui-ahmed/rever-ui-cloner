{
  "openapi": "3.1.0",
  "info": {
    "title": "Rever API",
    "version": "4.0.0",
    "summary": "Website intelligence for agents: UI prompts, design tokens, screenshots, tech stack.",
    "description": "Takes a screenshot of a public URL and returns a detailed design brief (layout, components, colors, typography, spacing) that a code-generation model can use to rebuild the UI in React + Tailwind. Price $0.25 per successful call. Agents pay with x402 v2 (exact scheme, USDC on Base eip155:8453): the first call returns 402 with a PAYMENT-REQUIRED header; retry with PAYMENT-SIGNATURE. Also accepted: X-Payment with the hash of a direct USDC transfer, or X-Access-Key from a pack bought on the website. Full guide: https://www.aypiai.online/llms-full.txt",
    "contact": {
      "name": "Ahmed Chaoui",
      "url": "https://github.com/chaoui-ahmed/rever-ui-cloner"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "externalDocs": {
    "url": "https://www.aypiai.online/llms-full.txt"
  },
  "servers": [
    {
      "url": "https://www.aypiai.online/api"
    }
  ],
  "paths": {
    "/generate-prompt": {
      "post": {
        "operationId": "generateUiPrompt",
        "summary": "Generate a UI-recreation prompt from a URL",
        "description": "Use when a user wants to clone, copy or recreate the design of an existing website. Returns a text prompt (not code); pass it to a code model to generate the UI. Takes 10-30 seconds.",
        "security": [
          {
            "x402": []
          },
          {
            "x402Payment": []
          },
          {
            "accessKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public http(s) URL of the page to recreate.",
                    "examples": [
                      "https://stripe.com"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prompt generated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "description": "Design brief to give to a code-generation model."
                    },
                    "url": {
                      "type": "string"
                    },
                    "remaining": {
                      "type": "integer",
                      "description": "Generations left on the access key (access-key payments only)."
                    }
                  }
                }
              }
            },
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "x402 settlement receipt (base64 JSON), on x402 payments.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid URL."
          },
          "401": {
            "description": "Invalid or unknown access key."
          },
          "402": {
            "description": "Payment required or rejected. x402: decode the base64 JSON PAYMENT-REQUIRED header (accepts: scheme exact, network eip155:8453, asset USDC, amount 250000, payTo) and retry with PAYMENT-SIGNATURE.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "x402Version": {
                      "type": "integer"
                    },
                    "accepts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "scheme": {
                            "type": "string"
                          },
                          "network": {
                            "type": "string"
                          },
                          "chainId": {
                            "type": "integer"
                          },
                          "asset": {
                            "type": "string"
                          },
                          "maxAmountRequired": {
                            "type": "string"
                          },
                          "payTo": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "howToPay": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Screenshot or model failed. The payment or generation is released; retry with the same hash/key."
          }
        }
      }
    },
    "/balance": {
      "get": {
        "operationId": "getBalance",
        "summary": "Generations left on an access key",
        "security": [
          {
            "accessKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "remaining": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid access key."
          }
        }
      }
    },
    "/design-tokens": {
      "post": {
        "operationId": "getDesignTokens",
        "summary": "Extract design tokens from a URL",
        "description": "Color palette with roles, fonts and type scale, spacing, radii, shadows, light/dark mode and a Tailwind theme extension, as JSON. Price: $0.05 per call via x402 (USDC on Base).",
        "security": [
          {
            "x402": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "tokens": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402): decode PAYMENT-REQUIRED header, retry with PAYMENT-SIGNATURE."
          },
          "400": {
            "description": "Invalid URL."
          },
          "502": {
            "description": "Upstream failure; not charged."
          }
        },
        "x-payment-info": {
          "protocol": "x402",
          "price": "0.05",
          "network": "eip155:8453",
          "asset": "USDC"
        }
      }
    },
    "/screenshot": {
      "post": {
        "operationId": "takeScreenshot",
        "summary": "Screenshot a web page",
        "description": "JPEG screenshot returned as a base64 data URL and a hosted URL. Price: $0.02 per call via x402 (USDC on Base).",
        "security": [
          {
            "x402": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 2560
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 300,
                    "maximum": 8000
                  },
                  "fullPage": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "image": {
                      "type": "string"
                    },
                    "imageUrl": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "bytes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402): decode PAYMENT-REQUIRED header, retry with PAYMENT-SIGNATURE."
          },
          "400": {
            "description": "Invalid URL."
          },
          "502": {
            "description": "Upstream failure; not charged."
          }
        },
        "x-payment-info": {
          "protocol": "x402",
          "price": "0.02",
          "network": "eip155:8453",
          "asset": "USDC"
        }
      }
    },
    "/tech-stack": {
      "post": {
        "operationId": "detectTechStack",
        "summary": "Detect a website's tech stack",
        "description": "Framework, site builder, hosting/CDN, CSS, analytics, payments, auth and support tools, with evidence. Price: $0.02 per call via x402 (USDC on Base).",
        "security": [
          {
            "x402": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "technologies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "category": {
                            "type": "string"
                          },
                          "evidence": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402): decode PAYMENT-REQUIRED header, retry with PAYMENT-SIGNATURE."
          },
          "400": {
            "description": "Invalid URL."
          },
          "502": {
            "description": "Upstream failure; not charged."
          }
        },
        "x-payment-info": {
          "protocol": "x402",
          "price": "0.02",
          "network": "eip155:8453",
          "asset": "USDC"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 v2 payment payload (base64 JSON, exact scheme, USDC on Base). Use any x402 client."
      },
      "x402Payment": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Payment",
        "description": "Base transaction hash of a direct 0.25 USDC transfer to the payTo address. Single use."
      },
      "accessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Key",
        "description": "Access key from a pack bought on https://www.aypiai.online (Stripe checkout session id, cs_...)."
      }
    }
  },
  "x-payment-info": {
    "protocol": "x402",
    "version": 2,
    "scheme": "exact",
    "network": "eip155:8453",
    "asset": "USDC",
    "price": "0.25"
  }
}