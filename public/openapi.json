                      "type": "string"
                    },
                    "markdown": {
                      "type": "string"
                    },
                    "chars": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required (x402)."
          },
          "400": {
            "description": "Invalid URL."
          },
          "502": {
            "description": "Upstream failure; not charged."
