  },
  "components": {
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 v2 payment payload (base64 JSON, exact scheme, USDC on Base). Use any x402 client."
      },
      "x402Payment": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Payment",
        "description": "Base transaction hash of a direct 0.25 USDC transfer to the payTo address. Single use."
      },
      "accessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Key",
        "description": "Access key from a pack bought on https://www.aypiai.online (Stripe checkout session id, cs_...)."
      }
    }
  },
  "x-payment-info": {
    "protocol": "x402",
    "version": 2,
    "scheme": "exact",
    "network": "eip155:8453",
    "asset": "USDC",
    "price": "0.25"
  }
}