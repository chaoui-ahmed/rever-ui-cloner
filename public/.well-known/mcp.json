{
  "name": "rever-ui-cloner",
  "title": "Rever",
  "description": "Turn a website URL into a prompt for recreating its UI with a code model.",
  "version": "3.0.0",
  "repository": "https://github.com/chaoui-ahmed/rever-ui-cloner",
  "documentation": "https://www.aypiai.online/llms-full.txt",
  "transport": [
    "streamable-http",
    "stdio"
  ],
  "install": {
    "command": "npx",
    "args": [
      "-y",
      "github:chaoui-ahmed/rever-ui-cloner#path:rever-mcp"
    ]
  },
  "tools": [
    {
      "name": "clone_ui",
      "description": "Generate a UI-recreation prompt from a public URL ($0.05). Pay with access_key (pack) or payment_tx (Base tx hash of a 0.05 USDC payment).",
      "inputSchema": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "payment_tx": {
            "type": "string"
          },
          "access_key": {
            "type": "string"
          }
        }
      }
    }
  ],
  "pricing": {
    "amount": "0.05",
    "currency": "USDC",
    "network": "base",
    "protocol": "x402"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.aypiai.online/mcp"
    }
  ]
}